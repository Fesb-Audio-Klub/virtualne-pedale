//funkcije mappaju vrijednost knobova (0-1) u stvarnje vrijednosti
namespace ValueScale {
    float scaleDelay(float delay){  //bazni delay je 15ms - 30ms
        return 15.0f + delay * 15.0f;
    }

    float scaleRate (float rate){   //rate je 0.2Hz - 2.5Hz
        return 0.2f + rate * 2.3f;
    }

    float scaleDepth(float depth){ //depth 2ms - 8ms
        return 2.0f + depth * 6.0f;
    }

    float scaleFeedback(float feedback){    //0%-20%
        return feedback * 0.2f;
    }
}

//low frequency oscillator - zasluzan za pitch shifting wet signala
processor LFO {
    //eventovi za knobove koji se tu koriste
    input event float delayIn;
    input event float rateIn;
    input event float depthIn;
    output stream float delayTimeOut;   //vraca trenutni delay za implementaciju u delay linea

    //trenutne vrijednosti parametara
    float delay = ValueScale::scaleDelay(0.5f);
    float rate = ValueScale::scaleRate(0.5f);
    float depth = ValueScale::scaleDepth(0.5f);

    //vrijednosti koje se racunaju
    float phase = 0.0f;
    float phaseIncrement = 0.0f;
    float wave = 0.0f;
    float currentDelay = 0.0f;

    //event handleri
    event delayIn (float newValue) { delay = ValueScale::scaleDelay(newValue); }
    event rateIn (float newValue)  { rate = ValueScale::scaleRate(newValue); }
    event depthIn (float newValue)  { depth = ValueScale::scaleDepth(newValue); }

    void main(){

        let SAMPLE_RATE = float (processor.frequency);  //dohvaca trenutni sample rate, nazalost ne moze globalno
       
        loop{
            phaseIncrement = float32 (twoPi * rate / SAMPLE_RATE);  //za koliko se u svakom koraku pomice faza
            phase = addModulo2Pi(phase, phaseIncrement);    //inkrementira fazu, granice [0,2pi>
            wave = sin(phase) * depth;  //sinusoida

            currentDelay = delay + wave;

            delayTimeOut <- currentDelay;
            advance();
        }
    }
}

//generira delay
processor DelayLine{
    input stream float audioIn;
    input stream float delayTimeIn;
    output stream float audioDelayedOut;

    input event float feedbackIn;

    float feedback = ValueScale::scaleFeedback(0.5f);

    event feedbackIn (float newValue) { feedback = ValueScale::scaleFeedback(newValue); }

    void main(){
        let SAMPLE_RATE = float (processor.frequency);

        float[9000] buffer;  //kruzni buffer
        float sample_count = 0.0f;   //trenutna kolicina uzoraka
        wrap<9000> writeIndex = 0;  //trenutna pozicija za pisanje u buffer
        float readIndex = 0.0f; //trenutna pozicija za citanje iz buffera
        
        //pomocne varijable za lerp
        wrap<9000> index_int = 0;
        wrap<9000> index_next = 0;
        float frac = 0.0f;
        float sample = 0.0f;

        loop{
            sample_count = delayTimeIn * (SAMPLE_RATE / 1000.0f);
            readIndex = wrap (float (writeIndex) - sample_count, float (9000));  //pozicija udaljena za trenutni broj sampleova od trenutne pozicije zapisivanja

            buffer[writeIndex] = audioIn;
            
            //linearna interpolacija (u slucaju da index uzorka nije cijeli broj, stvara uzorak iz dva susjedna uzorka) 
            index_int = wrap<9000> (floor(readIndex));
            index_next = wrap<9000> (index_int + 1);
            frac = readIndex - float(index_int);
            sample = std::intrinsics::lerp(buffer[index_int], buffer[index_next], frac);

            audioDelayedOut <- sample;

            buffer[writeIndex] = audioIn + sample * feedback;   //feedback

            writeIndex ++;
            advance();
        }
    }
}

//mix dry i wet signala, volume control
processor SignalMixer{
    input stream float inputDry;
    input stream float inputWet;
    output stream float blendOut;

    input event float blendIn;
    input event float levelIn;

    float blend = 0.5;
    float level = 0.5;

    event blendIn (float newValue) { blend = newValue; }
    event levelIn (float newValue) { level = newValue; }

    void main() {
        float out = 0.0f;
        loop {
            out = blend * inputWet + ( 1 - blend) * inputDry;
            out *= level;
            blendOut <- out;
            advance();
        }
    }
}

//graf koji spaja sve zasebne procesore u cjelinu
graph ChorusEffect [[main]] {
    input stream float audioIn;     //audio input
    output stream float audioOut;   //audio output

    //svi potrebni knobovi
    input event float delayParam [[name:"Delay", min:0, max:1, init: 0.5]];
    input event float depthParam [[ name: "Depth", min: 0, max: 1, init: 0.5]];
    input event float rateParam [[ name: "Rate", min: 0, max: 1, init: 0.5]];
    input event float feedbackParam [[ name: "Feedback", min: 0, max: 1, init: 0.5]];
    input event float blendParam [[ name: "Blend", min: 0, max: 1, init: 0.5]];
    input event float levelParam [[ name: "Level", min: 0, max: 1, init: 0.5]];

    //svaki node predstavlja instancu jednog procesora
    node lfo = LFO;
    node delayLine = DelayLine;
    node signalMixer = SignalMixer;
    
    //opisuje kako je sve medusobno spojeno
    connection {
        //knobovi
        delayParam -> lfo.delayIn;
        rateParam -> lfo.rateIn;
        depthParam -> lfo.depthIn;
        feedbackParam -> delayLine.feedbackIn;
        blendParam -> signalMixer.blendIn;
        levelParam -> signalMixer.levelIn;

        //delay
        lfo.delayTimeOut -> delayLine.delayTimeIn;

        //audio
        audioIn -> delayLine.audioIn;
        audioIn -> signalMixer.inputDry;
        delayLine.audioDelayedOut -> signalMixer.inputWet;
        signalMixer.blendOut -> audioOut;
    }
}